[Unit]
Description=Cardano on the Rocks OLED display service
Documentation=https://github.com/gufmar/cardano-on-the-rocks
After=local-fs.target
# Do not order after network; display must not depend on networking.

[Service]
Type=simple
User=cot-r-display
Group=i2c
SupplementaryGroups=i2c
EnvironmentFile=-/etc/cot-r/display.env
ExecStart=/usr/bin/python3 /opt/cot-r/display/cot_r_display/server.py
Restart=on-failure
RestartSec=3
# Resource / power hygiene
Nice=10
MemoryMax=64M
TasksMax=32
# Runtime directory for the Unix socket
RuntimeDirectory=cot-r
RuntimeDirectoryMode=0755
# Missing OLED must not take the machine down
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
