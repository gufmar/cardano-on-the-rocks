# Allow cot-r management to standby/resume the local AP and run Amaru ops.
# Installed by prepare to /etc/sudoers.d/cot-r-mgmt (mode 0440).
# Copyright (C) 2026 Markus. SPDX-License-Identifier: AGPL-3.0-only

cot-r ALL=(root) NOPASSWD: /usr/bin/systemctl stop cot-r-hostapd.service
cot-r ALL=(root) NOPASSWD: /usr/bin/systemctl start cot-r-hostapd.service
cot-r ALL=(root) NOPASSWD: /opt/cot-r/bin/cot-r-amaru-helper *
