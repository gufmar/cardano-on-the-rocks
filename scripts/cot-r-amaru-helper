#!/usr/bin/env bash
# Privileged Amaru ops for cot-r-mgmt (invoked via sudo -n).
# Copyright (C) 2026 Markus. SPDX-License-Identifier: AGPL-3.0-only
set -euo pipefail

AMARU_ENV_FILE="${AMARU_ENV_FILE:-/etc/default/amaru}"
AMARU_HOME="${AMARU_HOME:-/var/lib/amaru}"
AMARU_SERVICE="${AMARU_SERVICE:-amaru.service}"
AMARU_BOOTSTRAP_SERVICE="${AMARU_BOOTSTRAP_SERVICE:-amaru-bootstrap.service}"
COT_R_ETC="${COT_R_ETC_DIR:-/etc/cot-r}"
COT_R_AMARU_CONF="${COT_R_ETC}/amaru-node.env"
COT_R_CACHE="${COT_R_AMARU_CACHE:-/var/cache/cot-r/amaru}"
COT_R_RUN="${COT_R_RUN_DIR:-/run/cot-r}"
GH_REPO="${COT_R_AMARU_GH_REPO:-pragma-org/amaru}"
ARCH="$(uname -m)"
case "$ARCH" in
  aarch64|arm64) DEB_ARCH=aarch64 ;;
  x86_64|amd64) DEB_ARCH=x86_64 ;;
  *) echo "{\"ok\":false,\"error\":\"unsupported arch ${ARCH}\"}" >&2; exit 2 ;;
esac

json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()[:-1] if False else sys.argv[1]))' "$1"
}

ensure_conf() {
  mkdir -p "${COT_R_ETC}"
  if [[ ! -f "${COT_R_AMARU_CONF}" ]]; then
    cat >"${COT_R_AMARU_CONF}" <<'EOF'
# cot-r Amaru presentation / wizard flags (not Amaru upstream)
COT_R_NODE_IMPL=none
COT_R_AMARU_AUTO_START=0
COT_R_AMARU_BOOTSTRAP_DONE=0
COT_R_AMARU_VERSION=
EOF
    chmod 0640 "${COT_R_AMARU_CONF}"
    chown root:cot-r "${COT_R_AMARU_CONF}" 2>/dev/null || true
  fi
}

read_conf_var() {
  local key="$1" default="${2:-}"
  ensure_conf
  local line
  line="$(grep -E "^${key}=" "${COT_R_AMARU_CONF}" 2>/dev/null | tail -n1 || true)"
  if [[ -z "$line" ]]; then
    printf '%s' "$default"
    return
  fi
  printf '%s' "${line#*=}"
}

set_conf_var() {
  local key="$1" val="$2"
  ensure_conf
  if grep -qE "^${key}=" "${COT_R_AMARU_CONF}" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "${COT_R_AMARU_CONF}"
  else
    echo "${key}=${val}" >>"${COT_R_AMARU_CONF}"
  fi
}

package_installed() {
  dpkg -s amaru >/dev/null 2>&1
}

package_version() {
  if package_installed; then
    dpkg-query -W -f='${Version}' amaru 2>/dev/null || true
  fi
}

service_state() {
  local unit="$1" out
  # is-active exits non-zero for activating/failed; still print the state word.
  out="$(systemctl is-active "$unit" 2>/dev/null || true)"
  printf '%s' "${out:-unknown}"
}

service_enabled() {
  local unit="$1" out
  out="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
  printf '%s' "${out:-unknown}"
}

# Read KEY from /etc/default/amaru (or similar), strip surrounding quotes/spaces.
env_get_var() {
  local key="$1" file="${2:-$AMARU_ENV_FILE}" line val
  [[ -f "$file" ]] || return 0
  line="$(grep -E "^${key}=" "$file" 2>/dev/null | tail -n1 || true)"
  [[ -n "$line" ]] || return 0
  val="${line#*=}"
  val="${val#"${val%%[![:space:]]*}"}"
  val="${val%"${val##*[![:space:]]}"}"
  if [[ "$val" == \"*\" ]]; then val="${val:1:-1}"; fi
  if [[ "$val" == \'*\' ]]; then val="${val:1:-1}"; fi
  printf '%s' "$val"
}

amaru_network() {
  local net
  net="$(env_get_var AMARU_NETWORK)"
  printf '%s' "${net:-mainnet}"
}

db_chain_path() {
  local p
  p="$(env_get_var AMARU_DB_CHAIN)"
  if [[ -n "$p" ]]; then
    printf '%s' "$p"
  else
    printf '%s' "${AMARU_HOME}/chain.$(amaru_network).db"
  fi
}

db_ledger_path() {
  local p
  p="$(env_get_var AMARU_DB_LEDGER)"
  if [[ -n "$p" ]]; then
    printf '%s' "$p"
  else
    printf '%s' "${AMARU_HOME}/ledger.$(amaru_network).db"
  fi
}

# True when chain or ledger dir exists and looks non-empty (has entries beyond . / ..).
db_present() {
  local chain ledger
  chain="$(db_chain_path)"
  ledger="$(db_ledger_path)"
  python3 - "$chain" "$ledger" <<'PY'
import os, sys
for path in sys.argv[1:]:
    if not path or not os.path.isdir(path):
        continue
    try:
        entries = [e for e in os.listdir(path) if e not in (".", "..")]
    except PermissionError:
        # Dir exists but unreadable to this user; treat as present.
        raise SystemExit(0)
    if entries:
        raise SystemExit(0)
raise SystemExit(1)
PY
}

data_bytes() {
  if [[ -d "${AMARU_HOME}" ]]; then
    du -sb "${AMARU_HOME}" 2>/dev/null | awk '{print $1}'
  else
    echo 0
  fi
}

BOOTSTRAP_MARK="${COT_R_RUN}/amaru-bootstrap.mark.json"

write_bootstrap_mark() {
  mkdir -p "${COT_R_RUN}"
  local now baseline
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  baseline="$(data_bytes)"
  python3 -c 'import json,sys; print(json.dumps({
    "started_at": sys.argv[1],
    "baseline_bytes": int(sys.argv[2]),
  }))' "$now" "$baseline" >"${BOOTSTRAP_MARK}"
  chmod 0640 "${BOOTSTRAP_MARK}" 2>/dev/null || true
  chown root:cot-r "${BOOTSTRAP_MARK}" 2>/dev/null || true
}

# Emit bootstrap progress JSON object to stdout (single line).
bootstrap_progress_json() {
  local boot_active="$1"
  python3 - "${AMARU_BOOTSTRAP_SERVICE}" "${AMARU_HOME}" "${BOOTSTRAP_MARK}" "$boot_active" <<'PY'
import json, subprocess, sys
from pathlib import Path

unit, home, mark_path, boot_active = sys.argv[1:5]
out = {
    "unit_state": boot_active,
    "downloaded_bytes": None,
    "completed_snapshots": None,
    "message": None,
    "data_bytes": 0,
    "baseline_bytes": None,
    "delta_bytes": None,
    "started_at": None,
    "failed": False,
    "error": None,
    "last_log": None,
}

try:
    out["data_bytes"] = int(
        subprocess.check_output(["du", "-sb", home], text=True, stderr=subprocess.DEVNULL).split()[0]
    )
except Exception:
    out["data_bytes"] = 0

mark = Path(mark_path)
if mark.is_file():
    try:
        m = json.loads(mark.read_text(encoding="utf-8"))
        out["started_at"] = m.get("started_at")
        out["baseline_bytes"] = int(m.get("baseline_bytes") or 0)
        out["delta_bytes"] = max(0, out["data_bytes"] - out["baseline_bytes"])
    except Exception:
        pass

# Parse recent journal for progress + errors
try:
    raw = subprocess.check_output(
        ["journalctl", "-u", unit, "-n", "80", "-o", "cat", "--no-pager"],
        text=True,
        stderr=subprocess.DEVNULL,
    )
except Exception:
    raw = ""

last_progress = None
last_error = None
last_line = None
complete = False
IGNORE_PLAIN = (
    "consumed ",
    "deactivated successfully",
    "finished amaru-bootstrap",
    "started amaru-bootstrap",
)

def _noise_plain(text: str) -> bool:
    low = text.lower()
    return any(tok in low for tok in IGNORE_PLAIN)

for line in raw.splitlines():
    s = line.strip()
    if not s:
        continue
    if not _noise_plain(s):
        last_line = s[:300]
    try:
        obj = json.loads(s)
    except Exception:
        low = s.lower()
        if _noise_plain(s):
            continue
        if ("error" in low or "failed" in low) and "consumed" not in low:
            last_error = s[:400]
        continue
    fields = obj.get("fields") or {}
    level = str(obj.get("level") or "").upper()
    msg = str(fields.get("message") or obj.get("message") or "")
    if msg in ("progress.download", "progress.complete", "complete") or "downloaded_bytes" in fields:
        last_progress = dict(fields)
        last_progress["_msg"] = msg
    if msg in ("progress.complete", "complete"):
        complete = True
    if level in ("ERROR", "ERR") or (
        ("error" in msg.lower() or "fail" in msg.lower())
        and msg not in ("progress.complete", "complete")
    ):
        err_txt = fields.get("error") or fields.get("message") or msg or s
        last_error = str(err_txt)[:400]

if last_progress:
    try:
        if last_progress.get("downloaded_bytes") is not None:
            out["downloaded_bytes"] = int(last_progress.get("downloaded_bytes"))
    except Exception:
        pass
    try:
        if last_progress.get("completed_snapshots") is not None:
            out["completed_snapshots"] = int(last_progress.get("completed_snapshots"))
    except Exception:
        pass
    out["message"] = last_progress.get("_msg") or last_progress.get("message") or "progress.download"
    if last_progress.get("epoch") is not None:
        out["epoch"] = last_progress.get("epoch")
    if last_progress.get("point") is not None:
        out["point"] = last_progress.get("point")

out["complete"] = complete

# Unit failure (not "inactive" after success)
try:
    failed = subprocess.run(
        ["systemctl", "is-failed", unit],
        capture_output=True, text=True, timeout=3, check=False,
    ).stdout.strip()
    if failed == "failed":
        out["failed"] = True
except Exception:
    pass

# Result= from systemctl show
result = ""
status_code = ""
try:
    show = subprocess.check_output(
        ["systemctl", "show", unit, "-p", "Result", "-p", "ExecMainStatus", "--value"],
        text=True, stderr=subprocess.DEVNULL,
    ).strip().splitlines()
    result = show[0] if show else ""
    status_code = show[1] if len(show) > 1 else ""
    out["systemd_result"] = result
    out["systemd_status"] = status_code
    if result and result not in ("success", ""):
        out["failed"] = True
        if not out["error"]:
            out["error"] = f"systemd Result={result} status={status_code}"
except Exception:
    pass

# Successful complete must not be reported as failure
if complete and result in ("success", ""):
    out["failed"] = False
    last_error = None

if last_error and out["failed"]:
    out["error"] = last_error
elif last_error and not complete:
    out["error"] = last_error
if last_line:
    out["last_log"] = last_line

# Prefer downloaded_bytes as delta display when mark missing
if out["delta_bytes"] is None and out["downloaded_bytes"] is not None:
    out["delta_bytes"] = out["downloaded_bytes"]

print(json.dumps(out))
PY
}

# Bounded operator projection from amaru.service JSON journal traces + host samples.
run_progress_json() {
  local unit_state="$1"
  python3 - "${AMARU_SERVICE}" "$unit_state" <<'PY'
import json, os, subprocess, sys
from collections import Counter

unit, unit_state = sys.argv[1], sys.argv[2]


def point_tuple(raw):
    if not isinstance(raw, list) or not raw:
        return None
    slot = block = None
    hh = None
    try:
        slot = int(raw[0])
    except Exception:
        pass
    if len(raw) > 1 and isinstance(raw[1], str):
        hh = raw[1]
    if len(raw) > 2:
        try:
            block = int(raw[2])
        except Exception:
            pass
    return {"slot": slot, "block_no": block, "header_hash": hh, "point": raw}


def msg_name(fields):
    m = fields.get("message")
    if isinstance(m, dict):
        return str(m.get("name") or "")
    if m is None:
        return ""
    return str(m)


def host_sample():
    host = {
        "load1": None,
        "load5": None,
        "load15": None,
        "mem_total_mb": None,
        "mem_available_mb": None,
        "mem_used_pct": None,
        "nproc": os.cpu_count(),
    }
    try:
        with open("/proc/loadavg", "r", encoding="utf-8") as fh:
            parts = fh.read().split()
        host["load1"] = float(parts[0])
        host["load5"] = float(parts[1])
        host["load15"] = float(parts[2])
    except Exception:
        pass
    try:
        info = {}
        with open("/proc/meminfo", "r", encoding="utf-8") as fh:
            for line in fh:
                if ":" not in line:
                    continue
                k, v = line.split(":", 1)
                info[k.strip()] = v.strip()
        total_kb = int(info.get("MemTotal", "0").split()[0])
        avail_kb = int(info.get("MemAvailable", "0").split()[0])
        host["mem_total_mb"] = round(total_kb / 1024.0, 1)
        host["mem_available_mb"] = round(avail_kb / 1024.0, 1)
        if total_kb > 0:
            host["mem_used_pct"] = round(100.0 * (1.0 - (avail_kb / float(total_kb))), 1)
    except Exception:
        pass
    return host


out = {
    "unit_state": unit_state,
    "running": unit_state == "active",
    "phase": "stopped",
    "slot": None,
    "block_no": None,
    "header_hash": None,
    "point": None,
    "network_tip": None,
    "gap_blocks": None,
    "gap_slots": None,
    "sync_pct": None,
    "peers": [],
    "event_counts": {},
    "recent": [],
    "host": host_sample(),
    "detail": None,
}
if unit_state != "active":
    if unit_state == "activating":
        out["phase"] = "starting"
        out["detail"] = "Amaru service is starting"
    elif unit_state == "failed":
        out["phase"] = "failed"
        out["detail"] = "Amaru service failed"
    else:
        out["phase"] = "stopped"
        out["detail"] = "Amaru is not running"
    print(json.dumps(out))
    raise SystemExit(0)

# Prefer tip-related INFO lines. Plain -n 800 is drowned by DEBUG enter/exit after reboot.
raw = ""
for cmd in (
    [
        "journalctl",
        "-u",
        unit,
        "-n",
        "1500",
        "-o",
        "cat",
        "--no-pager",
        "--grep",
        r"tip\.(adopt|update)|chainsync\.(roll_forward_done|intersect_found|roll_backward)|chain\.(tip_accepted|best_tip_candidate)",
    ],
    [
        "journalctl",
        "-u",
        unit,
        "-n",
        "400",
        "-p",
        "info..alert",
        "-o",
        "cat",
        "--no-pager",
    ],
):
    try:
        chunk = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
    except Exception:
        chunk = ""
    if chunk.strip():
        raw = chunk
        break
if not raw:
    try:
        raw = subprocess.check_output(
            ["journalctl", "-u", unit, "-n", "1200", "-o", "cat", "--no-pager"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        raw = ""

# Local adopted tip vs peer-advertised network tip must not be mixed.
# tip.adopt / tip.update / chain.tip_accepted are LOCAL.
# chainsync.intersect_found / roll_backward / roll_forward_done: current=local, highest/tip=network.
local = None
net = None
headers_max = None  # tip.adopt max_block_height (headers ahead of adopted)
peer_hits = Counter()
peer_last = {}
event_counts = Counter()
recent = []
interesting = {
    "tip.adopt",
    "tip.update",
    "block.adopted",
    "block.received",
    "chainsync.roll_forward_done",
    "chainsync.intersect_found",
    "chainsync.roll_backward",
    "header.announced",
    "chain.tip_accepted",
    "chain.best_tip_candidate",
    "chain.resume_fetch",
    "perf.header.lifecycle",
}


def better_tip(a, b):
    """Return the tip with higher block_no, then higher slot (high-water)."""
    if a is None:
        return b
    if b is None:
        return a
    ab, bb = a.get("block_no"), b.get("block_no")
    if ab is not None and bb is not None and bb != ab:
        return b if bb > ab else a
    aslot, bslot = a.get("slot"), b.get("slot")
    if aslot is not None and bslot is not None and bslot != aslot:
        return b if bslot > aslot else a
    return b


def as_local(pt=None, slot=None, block=None, header_hash=None, point=None):
    tip = {
        "slot": slot,
        "block_no": block,
        "header_hash": header_hash if isinstance(header_hash, str) else None,
        "point": point,
    }
    if pt:
        tip = {
            "slot": pt.get("slot") if tip["slot"] is None else tip["slot"],
            "block_no": pt.get("block_no") if tip["block_no"] is None else tip["block_no"],
            "header_hash": tip["header_hash"] or pt.get("header_hash"),
            "point": tip["point"] if tip["point"] is not None else pt.get("point"),
        }
    if tip["slot"] is None and tip["block_no"] is None:
        return None
    return tip


for line in raw.splitlines():
    s = line.strip()
    if not s.startswith("{"):
        continue
    try:
        obj = json.loads(s)
    except Exception:
        continue
    fields = obj.get("fields") or {}
    name = msg_name(fields)
    if name and name not in ("enter", "exit", "close"):
        event_counts[name] += 1

    peer = fields.get("peer")
    if isinstance(peer, str) and peer:
        peer_hits[peer] += 1
        if name and name not in ("enter", "exit", "close"):
            peer_last[peer] = name
        elif peer not in peer_last:
            peer_last[peer] = name or "seen"

    hh = fields.get("header_hash") if isinstance(fields.get("header_hash"), str) else None

    # --- local adopted / chain tip ---
    if name in ("tip.adopt", "tip.update"):
        try:
            local = better_tip(
                local,
                as_local(
                    slot=int(fields["slot"]) if fields.get("slot") is not None else None,
                    block=int(fields["block_height"])
                    if fields.get("block_height") is not None
                    else None,
                    header_hash=hh,
                ),
            )
        except Exception:
            pass
        if fields.get("max_block_height") is not None:
            try:
                mh = int(fields["max_block_height"])
                headers_max = mh if headers_max is None else max(headers_max, mh)
            except Exception:
                pass
    elif name in ("chain.tip_accepted", "chain.best_tip_candidate"):
        # Their "tip" field is the local chain tip, not the peer network tip.
        local = better_tip(local, as_local(pt=point_tuple(fields.get("tip")), header_hash=hh))
    elif name in (
        "chainsync.roll_forward_done",
        "chainsync.intersect_found",
        "chainsync.roll_backward",
    ):
        cur = point_tuple(fields.get("current"))
        if fields.get("current_height") is not None and cur:
            try:
                cur["block_no"] = int(fields["current_height"])
            except Exception:
                pass
        local = better_tip(local, as_local(pt=cur, header_hash=hh))
        # Peer-advertised network tip (stable source).
        for key in ("highest", "tip"):
            net = better_tip(net, point_tuple(fields.get(key)))
        if fields.get("tip_height") is not None:
            try:
                th = int(fields["tip_height"])
                if net is None:
                    net = {
                        "slot": None,
                        "block_no": th,
                        "header_hash": None,
                        "point": None,
                    }
                else:
                    net = better_tip(
                        net,
                        {
                            "slot": net.get("slot"),
                            "block_no": th,
                            "header_hash": net.get("header_hash"),
                            "point": net.get("point"),
                        },
                    )
            except Exception:
                pass
    else:
        # point on spans is local work; do not treat span "tip" as network tip
        # unless it is clearly ahead of local (peer-advertised).
        pt = point_tuple(fields.get("point"))
        if pt:
            local = better_tip(local, as_local(pt=pt, header_hash=hh))
        tip_pt = point_tuple(fields.get("tip"))
        if tip_pt and tip_pt.get("block_no") is not None:
            local_block = (local or {}).get("block_no")
            # Peer tip on roll_forward spans: always track as network tip when
            # we already know local, or when it is clearly ahead. Never invent
            # "catch-up" from peer tip alone with local still unknown.
            if local_block is not None and tip_pt["block_no"] >= int(local_block):
                net = better_tip(net, tip_pt)
            elif local_block is None and tip_pt["block_no"] is not None:
                net = better_tip(net, tip_pt)

    if name in interesting:
        snap = {
            "message": name,
            "peer": peer if isinstance(peer, str) else None,
            "outcome": fields.get("outcome"),
            "header_hash": hh,
        }
        if local:
            snap["slot"] = local.get("slot")
            snap["block_no"] = local.get("block_no")
        recent.append(snap)

if local:
    out["slot"] = local.get("slot")
    out["block_no"] = local.get("block_no")
    out["header_hash"] = local.get("header_hash")
    out["point"] = local.get("point")
if net:
    out["network_tip"] = {
        "slot": net.get("slot"),
        "block_no": net.get("block_no"),
        "header_hash": net.get("header_hash"),
    }
out["headers_max_block"] = headers_max
if headers_max is not None and local and local.get("block_no") is not None:
    out["headers_ahead"] = max(0, int(headers_max) - int(local["block_no"]))
else:
    out["headers_ahead"] = None

gap_blocks = gap_slots = sync_pct = None
if local and net:
    if local.get("block_no") is not None and net.get("block_no") is not None:
        gap_blocks = max(0, int(net["block_no"]) - int(local["block_no"]))
        if net["block_no"] > 0:
            sync_pct = round(
                100.0 * min(1.0, float(local["block_no"]) / float(net["block_no"])), 3
            )
    if local.get("slot") is not None and net.get("slot") is not None:
        gap_slots = max(0, int(net["slot"]) - int(local["slot"]))
out["gap_blocks"] = gap_blocks
out["gap_slots"] = gap_slots
out["sync_pct"] = sync_pct

out["peers"] = [
    {"addr": addr, "events": int(n), "last_message": peer_last.get(addr)}
    for addr, n in peer_hits.most_common(12)
]
out["event_counts"] = {k: int(v) for k, v in event_counts.most_common(20)}
out["recent"] = recent[-8:]

if local and (local.get("slot") is not None or local.get("block_no") is not None):
    # RockPi demos: treat small gaps as on tip (chainsync jitter / slot lag).
    # If we have a local tip but no peer tip sample, prefer on_tip over a false catch-up.
    on_tip = gap_blocks is None and gap_slots is None
    if gap_blocks is not None and gap_blocks <= 300:
        on_tip = True
    if gap_slots is not None and gap_slots <= 300:
        on_tip = True
    if gap_blocks is not None and gap_blocks > 300:
        on_tip = False
    if gap_slots is not None and gap_slots > 300 and (
        gap_blocks is None or gap_blocks > 300
    ):
        on_tip = False
    out["phase"] = "on_tip" if on_tip else "catching_up"
    bits = []
    if local.get("slot") is not None:
        bits.append(f"slot {local['slot']}")
    if local.get("block_no") is not None:
        bits.append(f"block {local['block_no']}")
    if gap_blocks is not None:
        bits.append(f"{gap_blocks} blocks behind peer tip")
    elif gap_slots is not None:
        bits.append(f"{gap_slots} slots behind peer tip")
    if out.get("headers_ahead"):
        bits.append(f"{out['headers_ahead']} headers buffered ahead of adopted tip")
    if on_tip:
        out["detail"] = (
            "Node start success. On peer network tip (" + ", ".join(bits) + ")."
        )
    else:
        out["detail"] = (
            "Node start success. Catching up from snapshot toward peer tip ("
            + ", ".join(bits)
            + "). CPU stays high until on tip."
        )
else:
    out["phase"] = "starting"
    out["detail"] = "Node is running; waiting for first tip progress in journals…"
print(json.dumps(out))
PY
}

cmd_status() {
  ensure_conf
  local installed="false" ver="" active="" enabled="" boot_active="" boot_done auto_start impl
  if package_installed; then
    installed="true"
    ver="$(package_version)"
  fi
  active="$(service_state "${AMARU_SERVICE}")"
  enabled="$(service_enabled "${AMARU_SERVICE}")"
  boot_active="$(service_state "${AMARU_BOOTSTRAP_SERVICE}")"
  boot_done="$(read_conf_var COT_R_AMARU_BOOTSTRAP_DONE 0)"
  auto_start="$(read_conf_var COT_R_AMARU_AUTO_START 0)"
  impl="$(read_conf_var COT_R_NODE_IMPL none)"
  local has_db="false"
  if db_present; then has_db="true"; fi
  if [[ "$has_db" == true && "$boot_done" != "1" ]]; then
    boot_done=1
    set_conf_var COT_R_AMARU_BOOTSTRAP_DONE 1
  fi
  local env_exists="false"
  [[ -f "${AMARU_ENV_FILE}" ]] && env_exists="true"
  local boot_done_json="false" auto_json="false"
  [[ "$boot_done" == "1" ]] && boot_done_json="true"
  [[ "$auto_start" == "1" ]] && auto_json="true"
  local progress run
  progress="$(bootstrap_progress_json "$boot_active" 2>/dev/null || echo '{}')"
  run="$(run_progress_json "$active" 2>/dev/null || echo '{}')"
  python3 -c 'import json,sys
prog=json.loads(sys.argv[14] or "{}")
run=json.loads(sys.argv[15] or "{}")
print(json.dumps({
  "ok": True,
  "impl": sys.argv[1],
  "installed": sys.argv[2] == "true",
  "version": sys.argv[3],
  "service_active": sys.argv[4],
  "service_enabled": sys.argv[5],
  "bootstrap_active": sys.argv[6],
  "bootstrap_done": sys.argv[7] == "true",
  "db_present": sys.argv[8] == "true",
  "auto_start": sys.argv[9] == "true",
  "env_file": sys.argv[10],
  "env_exists": sys.argv[11] == "true",
  "home": sys.argv[12],
  "cache_dir": sys.argv[13],
  "progress": prog,
  "run": run,
}))' \
    "$impl" "$installed" "$ver" "$active" "$enabled" "$boot_active" \
    "$boot_done_json" "$has_db" "$auto_json" \
    "${AMARU_ENV_FILE}" "$env_exists" "${AMARU_HOME}" "${COT_R_CACHE}" \
    "$progress" "$run"
}

resolve_version() {
  local pinned="${1:-}"
  if [[ -n "$pinned" ]]; then
    printf '%s' "$pinned"
    return
  fi
  pinned="$(read_conf_var COT_R_AMARU_VERSION "")"
  if [[ -n "$pinned" ]]; then
    printf '%s' "$pinned"
    return
  fi
  if [[ -n "${COT_R_AMARU_VERSION:-}" ]]; then
    printf '%s' "${COT_R_AMARU_VERSION}"
    return
  fi
  # Latest release tag from GitHub (strip leading v)
  local tag
  tag="$(curl -fsSL "https://api.github.com/repos/${GH_REPO}/releases/latest" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tag_name") or "")' 2>/dev/null || true)"
  tag="${tag#v}"
  if [[ -z "$tag" ]]; then
    echo "{\"ok\":false,\"error\":\"could not resolve latest Amaru release\"}" >&2
    exit 1
  fi
  printf '%s' "$tag"
}

cmd_install_file() {
  local path="${1:-}"
  [[ -n "$path" && -f "$path" ]] || { echo '{"ok":false,"error":"deb file required"}' >&2; exit 1; }
  DEBIAN_FRONTEND=noninteractive apt-get install -y "$path"
  local version
  version="$(package_version)"
  if [[ ! -f "${AMARU_ENV_FILE}" ]]; then
    cat >"${AMARU_ENV_FILE}" <<'EOF'
AMARU_NETWORK=mainnet
AMARU_DB_CHAIN=/var/lib/amaru/chain.mainnet.db
AMARU_DB_LEDGER=/var/lib/amaru/ledger.mainnet.db
AMARU_DB_CHAIN_AUTOMATIC_MIGRATION=true
AMARU_PID_EXPORT=/run/amaru/amaru.pid
AMARU_WITH_JSON_TRACES=true
EOF
  else
    if ! grep -qE '^AMARU_NETWORK=' "${AMARU_ENV_FILE}"; then
      echo "AMARU_NETWORK=mainnet" >>"${AMARU_ENV_FILE}"
    fi
  fi
  set_conf_var COT_R_NODE_IMPL amaru
  [[ -n "$version" ]] && set_conf_var COT_R_AMARU_VERSION "$version"
  if [[ "$(read_conf_var COT_R_AMARU_AUTO_START 0)" != "1" ]]; then
    systemctl disable "${AMARU_SERVICE}" 2>/dev/null || true
  fi
  cmd_status
}

cmd_install() {
  local version
  version="$(resolve_version "${1:-}")"
  mkdir -p "${COT_R_CACHE}"
  local deb="amaru-${version}-linux-${DEB_ARCH}.deb"
  local path="${COT_R_CACHE}/${deb}"
  local url="https://github.com/${GH_REPO}/releases/download/v${version}/${deb}"
  if [[ ! -f "$path" ]]; then
    curl -fL --retry 3 -o "${path}.partial" "$url"
    mv "${path}.partial" "$path"
  fi
  cmd_install_file "$path"
}

cmd_bootstrap() {
  # Start bootstrap asynchronously; status/progress is polled via cmd_status.
  package_installed || { echo '{"ok":false,"error":"amaru not installed"}' >&2; exit 1; }
  if db_present; then
    echo '{"ok":false,"error":"databases already present; wipe first"}' >&2
    exit 1
  fi
  local boot_state
  boot_state="$(service_state "${AMARU_BOOTSTRAP_SERVICE}")"
  if [[ "$boot_state" == "active" || "$boot_state" == "activating" ]]; then
    echo '{"ok":false,"error":"bootstrap already running"}' >&2
    exit 1
  fi
  write_bootstrap_mark
  if systemctl list-unit-files "${AMARU_BOOTSTRAP_SERVICE}" >/dev/null 2>&1; then
    systemctl reset-failed "${AMARU_BOOTSTRAP_SERVICE}" 2>/dev/null || true
    if ! systemctl start --no-block "${AMARU_BOOTSTRAP_SERVICE}"; then
      local why
      why="$(journalctl -u "${AMARU_BOOTSTRAP_SERVICE}" -n 20 -o cat --no-pager 2>/dev/null | tail -n 5 | tr '\n' ' ')"
      python3 -c 'import json,sys; print(json.dumps({"ok":False,"error":"failed to start amaru-bootstrap: "+sys.argv[1]}))' \
        "${why:-systemctl start failed}" >&2
      exit 1
    fi
  else
    local net
    net="$(amaru_network)"
    # No unit: run in background under amaru user
    mkdir -p "${COT_R_RUN}"
    nohup sudo -u amaru amaru node bootstrap --network "$net" \
      >"${COT_R_RUN}/amaru-bootstrap.out" 2>&1 &
    echo $! >"${COT_R_RUN}/amaru-bootstrap.pid"
  fi
  sleep 1
  cmd_status
}

cmd_bootstrap_stop() {
  # Stop Mithril/bootstrap without wiping DBs.
  systemctl stop "${AMARU_BOOTSTRAP_SERVICE}" 2>/dev/null || true
  # Kill leftover bootstrap / mithril client processes for user amaru
  pkill -u amaru -f 'amaru node bootstrap' 2>/dev/null || true
  pkill -u amaru -f 'mithril' 2>/dev/null || true
  if [[ -f "${COT_R_RUN}/amaru-bootstrap.pid" ]]; then
    local pid
    pid="$(cat "${COT_R_RUN}/amaru-bootstrap.pid" 2>/dev/null || true)"
    if [[ -n "$pid" ]]; then
      kill -TERM "$pid" 2>/dev/null || true
      sleep 1
      kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "${COT_R_RUN}/amaru-bootstrap.pid"
  fi
  systemctl reset-failed "${AMARU_BOOTSTRAP_SERVICE}" 2>/dev/null || true
  rm -f "${BOOTSTRAP_MARK}" 2>/dev/null || true
  sleep 1
  local st
  st="$(service_state "${AMARU_BOOTSTRAP_SERVICE}")"
  if [[ "$st" == "active" || "$st" == "activating" ]]; then
    # Force kill unit cgroup
    systemctl kill -s SIGKILL "${AMARU_BOOTSTRAP_SERVICE}" 2>/dev/null || true
    systemctl stop "${AMARU_BOOTSTRAP_SERVICE}" 2>/dev/null || true
    sleep 1
    st="$(service_state "${AMARU_BOOTSTRAP_SERVICE}")"
  fi
  if pgrep -u amaru -f 'amaru node bootstrap' >/dev/null 2>&1; then
    echo '{"ok":false,"error":"bootstrap process still running after stop"}' >&2
    exit 1
  fi
  python3 -c 'import json,sys; print(json.dumps({"ok":True,"stopped":True,"bootstrap_active":sys.argv[1]}))' "$st"
}

cmd_wipe() {
  cmd_bootstrap_stop >/dev/null || true
  systemctl stop "${AMARU_SERVICE}" 2>/dev/null || true
  if command -v amaru >/dev/null 2>&1; then
    sudo -u amaru amaru node rm --wipe-all-dbs --network "$(amaru_network)" 2>/dev/null || true
  fi
  # Fallback remove
  rm -rf "$(db_chain_path)" "$(db_ledger_path)" "${AMARU_HOME}/snapshots" \
    "${AMARU_HOME}/chain."*.db "${AMARU_HOME}/ledger."*.db 2>/dev/null || true
  set_conf_var COT_R_AMARU_BOOTSTRAP_DONE 0
  cmd_status
}

cmd_env_get() {
  if [[ ! -f "${AMARU_ENV_FILE}" ]]; then
    echo '{"ok":false,"error":"env file missing"}' >&2
    exit 1
  fi
  # Emit JSON {ok, path, vars:[{key,value,raw}]}
  python3 - "${AMARU_ENV_FILE}" <<'PY'
import json, sys
path = sys.argv[1]
vars_ = []
raw_lines = []
with open(path, encoding="utf-8") as f:
    for line in f:
        raw_lines.append(line.rstrip("\n"))
        s = line.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        k, v = s.split("=", 1)
        vars_.append({"key": k.strip(), "value": v.strip()})
print(json.dumps({"ok": True, "path": path, "vars": vars_, "text": "\n".join(raw_lines) + ("\n" if raw_lines else "")}))
PY
}

cmd_env_write() {
  # Write from a staging file written by mgmt under /run/cot-r/
  local src="${1:-}"
  [[ -n "$src" && -f "$src" ]] || { echo '{"ok":false,"error":"staging file required"}' >&2; exit 1; }
  case "$src" in
    "${COT_R_RUN}"/*) ;;
    *) echo '{"ok":false,"error":"staging path must be under /run/cot-r"}' >&2; exit 1 ;;
  esac
  install -m 0644 -o root -g root "$src" "${AMARU_ENV_FILE}"
  cmd_env_get
}

# Upsert KEY=VALUE in /etc/default/amaru (preserve other lines / comments).
env_upsert() {
  local key="$1" val="$2"
  python3 - "${AMARU_ENV_FILE}" "$key" "$val" <<'PY'
import sys
path, key, val = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
except FileNotFoundError:
    lines = []
out = []
found = False
for line in lines:
    s = line.strip()
    if s and not s.startswith("#") and "=" in s and s.split("=", 1)[0].strip() == key:
        out.append(f"{key}={val}")
        found = True
    else:
        out.append(line)
if not found:
    if out and out[-1].strip():
        out.append("")
    out.append(f"# cot-r catch-up tune")
    out.append(f"{key}={val}")
text = "\n".join(out) + "\n"
with open(path, "w", encoding="utf-8") as fh:
    fh.write(text)
PY
}

# RockPi 4 GiB catch-up: quiet default DEBUG consensus/ledger JSON spam; raise MemoryHigh.
cmd_tune_catchup() {
  local restart="${1:-1}"
  package_installed || { echo '{"ok":false,"error":"amaru not installed"}' >&2; exit 1; }
  [[ -f "${AMARU_ENV_FILE}" ]] || { echo '{"ok":false,"error":"env file missing"}' >&2; exit 1; }

  # Binary default is info + amaru::consensus=debug + amaru::ledger=debug → huge span enter/exit volume.
  env_upsert AMARU_LOG "info"
  env_upsert AMARU_TUI_OFF "true"
  # Keep JSON traces so wizard observe can still read tip.adopt / chainsync at info.
  env_upsert AMARU_WITH_JSON_TRACES "true"

  local drop_dir="/etc/systemd/system/amaru.service.d"
  mkdir -p "${drop_dir}"
  cat >"${drop_dir}/50-cot-r-catchup.conf" <<'EOF'
# Managed by cot-r-amaru-helper tune-catchup
# Upstream unit sets MemoryHigh=1G. Leave ~0.8 GiB for OS/mgmt on 4 GiB RockPi.
[Service]
MemoryHigh=3G
MemoryMax=infinity
EOF

  systemctl daemon-reload
  local restarted="false"
  if [[ "$restart" == "1" || "$restart" == "true" || "$restart" == "yes" ]]; then
    systemctl restart "${AMARU_SERVICE}"
    restarted="true"
  fi

  python3 -c 'import json,sys
print(json.dumps({
  "ok": True,
  "restarted": sys.argv[1] == "true",
  "applied": {
    "AMARU_LOG": "info",
    "AMARU_TUI_OFF": "true",
    "AMARU_WITH_JSON_TRACES": "true",
    "MemoryHigh": "3G",
  },
  "notes": [
    "Default Amaru log filter enables consensus/ledger DEBUG (span enter/exit flood into journald).",
    "Upstream amaru.service MemoryHigh=1G was reclaim-throttling; cot-r uses MemoryHigh=3G on 4 GiB.",
    "Optional later: raise AMARU_PEERS_MAX_UPSTREAM (e.g. 6) if uplink and RAM allow.",
  ],
}))' "$restarted"
}

cmd_service() {
  local action="$1"
  case "$action" in
    start|stop|restart)
      systemctl "$action" "${AMARU_SERVICE}"
      ;;
    *)
      echo '{"ok":false,"error":"bad service action"}' >&2
      exit 1
      ;;
  esac
  cmd_status
}

cmd_autostart() {
  local enabled="$1"
  ensure_conf
  if [[ "$enabled" == "1" || "$enabled" == "true" || "$enabled" == "on" ]]; then
    set_conf_var COT_R_AMARU_AUTO_START 1
    systemctl enable "${AMARU_SERVICE}"
    systemctl start "${AMARU_SERVICE}" || true
  else
    set_conf_var COT_R_AMARU_AUTO_START 0
    systemctl disable "${AMARU_SERVICE}" 2>/dev/null || true
    # Do not force-stop; operator may have started manually for the session
  fi
  cmd_status
}

# Relative names under AMARU_HOME for LAN DB copy (chain / ledger / snapshots).
snapshot_entries() {
  (cd "${AMARU_HOME}" && ls -d chain.*.db ledger.*.db snapshots 2>/dev/null || true)
}

cmd_snapshot_size() {
  package_installed || { echo '{"ok":false,"error":"amaru not installed"}' >&2; exit 1; }
  db_present || { echo '{"ok":false,"error":"no databases to export"}' >&2; exit 1; }
  local entries entry bytes=0
  mapfile -t entries < <(snapshot_entries)
  if [[ ${#entries[@]} -eq 0 ]]; then
    echo '{"ok":false,"error":"no snapshot entries"}' >&2
    exit 1
  fi
  for entry in "${entries[@]}"; do
    bytes=$((bytes + $(du -sb "${AMARU_HOME}/${entry}" 2>/dev/null | awk '{print $1}' || echo 0)))
  done
  python3 -c "import json,sys; print(json.dumps({'ok':True,'bytes':int(sys.argv[1]),'entries':sys.argv[2].split()}))" \
    "$bytes" "${entries[*]}"
}

cmd_snapshot_cache_clear() {
  mkdir -p "${COT_R_CACHE}"
  local removed=0
  local f
  for f in \
    "${COT_R_CACHE}/snapshot-mainnet.tgz" \
    "${COT_R_CACHE}/from-master-snapshot.tgz" \
    "${COT_R_CACHE}/"*.tgz \
    "${COT_R_CACHE}/"*.tgz.partial \
    "${COT_R_CACHE}/"*.partial
  do
    [[ -e "$f" ]] || continue
    case "$f" in
      *.deb) continue ;;
    esac
    rm -f "$f" && removed=$((removed + 1)) || true
  done
  python3 -c "import json,sys; print(json.dumps({'ok':True,'removed':int(sys.argv[1]),'cache':sys.argv[2]}))" \
    "$removed" "${COT_R_CACHE}"
}

# Stream uncompressed tar of DB dirs to stdout. Errors as JSON on stderr.
# No on-disk tarball (saves ~10 GiB and a long pack on 32 GiB eMMC).
cmd_snapshot_stream_out() {
  package_installed || { echo '{"ok":false,"error":"amaru not installed"}' >&2; exit 1; }
  db_present || { echo '{"ok":false,"error":"no databases to export"}' >&2; exit 1; }
  local entries
  mapfile -t entries < <(snapshot_entries)
  if [[ ${#entries[@]} -eq 0 ]]; then
    echo '{"ok":false,"error":"no snapshot entries"}' >&2
    exit 1
  fi
  systemctl stop "${AMARU_SERVICE}" 2>/dev/null || true
  # Uncompressed: RocksDB barely shrinks with gzip and ARM CPU is the bottleneck.
  tar -C "${AMARU_HOME}" -c --exclude='./lost+found' "${entries[@]}"
}

# Read uncompressed tar from stdin into AMARU_HOME (wipes prior chain/ledger/snapshots).
cmd_snapshot_stream_in() {
  package_installed || { echo '{"ok":false,"error":"amaru not installed"}' >&2; exit 1; }
  systemctl stop "${AMARU_SERVICE}" 2>/dev/null || true
  systemctl stop "${AMARU_BOOTSTRAP_SERVICE}" 2>/dev/null || true
  rm -rf "${AMARU_HOME}/chain."*.db "${AMARU_HOME}/ledger."*.db "${AMARU_HOME}/snapshots" 2>/dev/null || true
  mkdir -p "${AMARU_HOME}"
  tar -C "${AMARU_HOME}" -x
  chown -R amaru:amaru "${AMARU_HOME}" 2>/dev/null || true
  set_conf_var COT_R_AMARU_BOOTSTRAP_DONE 1
  set_conf_var COT_R_NODE_IMPL amaru
  cmd_status
}

# Legacy on-disk gzip export (prefer stream-out for LAN push).
cmd_snapshot_export() {
  local dest="${1:-}"
  [[ -n "$dest" ]] || { echo '{"ok":false,"error":"dest path required"}' >&2; exit 1; }
  case "$dest" in
    "${COT_R_CACHE}"/*|"${COT_R_RUN}"/*|/var/cache/cot-r/amaru/*) ;;
    *) echo '{"ok":false,"error":"export path not allowed"}' >&2; exit 1 ;;
  esac
  package_installed || { echo '{"ok":false,"error":"amaru not installed"}' >&2; exit 1; }
  db_present || { echo '{"ok":false,"error":"no databases to export"}' >&2; exit 1; }
  systemctl stop "${AMARU_SERVICE}" 2>/dev/null || true
  mkdir -p "$(dirname "$dest")"
  local entries
  mapfile -t entries < <(snapshot_entries)
  tar -C "${AMARU_HOME}" -czf "$dest" \
    --exclude='./lost+found' \
    "${entries[@]}"
  chown root:cot-r "$dest" 2>/dev/null || true
  chmod 0640 "$dest" 2>/dev/null || true
  local bytes
  bytes="$(stat -c%s "$dest" 2>/dev/null || echo 0)"
  python3 -c "import json; print(json.dumps({'ok':True,'path':'''$dest''','bytes':int('$bytes')}))"
}

cmd_snapshot_import() {
  local src="${1:-}"
  [[ -n "$src" && -f "$src" ]] || { echo '{"ok":false,"error":"archive required"}' >&2; exit 1; }
  package_installed || { echo '{"ok":false,"error":"amaru not installed"}' >&2; exit 1; }
  systemctl stop "${AMARU_SERVICE}" 2>/dev/null || true
  systemctl stop "${AMARU_BOOTSTRAP_SERVICE}" 2>/dev/null || true
  rm -rf "${AMARU_HOME}/chain."*.db "${AMARU_HOME}/ledger."*.db "${AMARU_HOME}/snapshots" 2>/dev/null || true
  mkdir -p "${AMARU_HOME}"
  case "$src" in
    *.tar|*.tar.*) tar -C "${AMARU_HOME}" -xf "$src" ;;
    *) tar -C "${AMARU_HOME}" -xzf "$src" ;;
  esac
  chown -R amaru:amaru "${AMARU_HOME}" 2>/dev/null || true
  set_conf_var COT_R_AMARU_BOOTSTRAP_DONE 1
  set_conf_var COT_R_NODE_IMPL amaru
  cmd_status
}

cmd_deb_path() {
  # Print path to cached deb for a version (or latest cached / resolved)
  local version
  version="$(resolve_version "${1:-}")"
  local deb="amaru-${version}-linux-${DEB_ARCH}.deb"
  local path="${COT_R_CACHE}/${deb}"
  if [[ ! -f "$path" ]]; then
    mkdir -p "${COT_R_CACHE}"
    curl -fL --retry 3 -o "${path}.partial" \
      "https://github.com/${GH_REPO}/releases/download/v${version}/${deb}"
    mv "${path}.partial" "$path"
  fi
  python3 -c "import json; print(json.dumps({'ok':True,'version':'''$version''','path':'''$path'''}))"
}

usage() {
  cat <<'EOF'
Usage: cot-r-amaru-helper <command> [args]
  status
  install [version]
  install-file <deb-path>
  bootstrap
  bootstrap-stop
  wipe
  env-get
  env-write <staging-file-under-/run/cot-r>
  tune-catchup [restart=1]
  service-start|service-stop|service-restart
  enable-autostart|disable-autostart
  snapshot-size
  snapshot-cache-clear
  snapshot-stream-out
  snapshot-stream-in
  snapshot-export <path>
  snapshot-import <path>
  deb-path [version]
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    status) cmd_status ;;
    install) cmd_install "${1:-}" ;;
    install-file) cmd_install_file "${1:-}" ;;
    bootstrap) cmd_bootstrap ;;
    bootstrap-stop) cmd_bootstrap_stop ;;
    wipe) cmd_wipe ;;
    env-get) cmd_env_get ;;
    env-write) cmd_env_write "${1:-}" ;;
    tune-catchup) cmd_tune_catchup "${1:-1}" ;;
    service-start) cmd_service start ;;
    service-stop) cmd_service stop ;;
    service-restart) cmd_service restart ;;
    enable-autostart) cmd_autostart 1 ;;
    disable-autostart) cmd_autostart 0 ;;
    snapshot-size) cmd_snapshot_size ;;
    snapshot-cache-clear) cmd_snapshot_cache_clear ;;
    snapshot-stream-out) cmd_snapshot_stream_out ;;
    snapshot-stream-in) cmd_snapshot_stream_in ;;
    snapshot-export) cmd_snapshot_export "${1:-}" ;;
    snapshot-import) cmd_snapshot_import "${1:-}" ;;
    deb-path) cmd_deb_path "${1:-}" ;;
    -h|--help|help) usage ;;
    *)
      echo "{\"ok\":false,\"error\":\"unknown command: ${cmd}\"}" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
