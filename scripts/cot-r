#!/usr/bin/env bash
# Cardano on the Rocks: system preparation entry point.
# Copyright (C) 2026 Markus. SPDX-License-Identifier: AGPL-3.0-only
#
# Usage:
#   cot-r status
#   cot-r prepare
#   cot-r reset-project
#   cot-r oled-test
#   cot-r version
#   cot-r help

set -euo pipefail

COT_R_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/lib" && pwd)"

# shellcheck source=lib/common.sh
source "${COT_R_LIB_DIR}/common.sh"
# shellcheck source=lib/state.sh
source "${COT_R_LIB_DIR}/state.sh"
# shellcheck source=lib/inspect.sh
source "${COT_R_LIB_DIR}/inspect.sh"
# shellcheck source=lib/packages.sh
source "${COT_R_LIB_DIR}/packages.sh"
# shellcheck source=lib/armbian.sh
source "${COT_R_LIB_DIR}/armbian.sh"
# shellcheck source=lib/users.sh
source "${COT_R_LIB_DIR}/users.sh"
# shellcheck source=lib/oled_hw.sh
source "${COT_R_LIB_DIR}/oled_hw.sh"
# shellcheck source=lib/services.sh
source "${COT_R_LIB_DIR}/services.sh"
# shellcheck source=lib/prepare.sh
source "${COT_R_LIB_DIR}/prepare.sh"

usage() {
  cat <<'EOF'
Cardano on the Rocks: provisioning helper

Usage: cot-r <command>

Commands:
  status          Inspect platform, network, I2C, and project state (no changes)
  prepare         Idempotent baseline preparation (requires root)
  reset-project   Stop project services, remove project-owned install, re-prepare (root)
  oled-test       Discover SSD1306 and render a short test pattern
  version         Print tool version
  help            Show this help

Source: https://github.com/gufmar/cardano-on-the-rocks
Licence: AGPL-3.0-only

Notes:
  - Never reboots or restarts networking by itself.
  - If the I2C7 overlay is newly staged, reboot when convenient, then re-run prepare.
  - Demo reset (REST) is separate and not handled here.
EOF
}

main() {
  local cmd="${1:-help}"
  case "$cmd" in
    status|inspect)
      cot_r_cmd_status
      ;;
    prepare)
      cot_r_cmd_prepare
      ;;
    reset-project|reset_project)
      cot_r_cmd_reset_project
      ;;
    oled-test|oled_test)
      cot_r_cmd_oled_test
      ;;
    version|--version|-V)
      echo "cot-r $(cot_r_version)"
      echo "repo ${COT_R_REPO_ROOT}"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage >&2
      die "Unknown command: ${cmd}"
      ;;
  esac
}

main "$@"
