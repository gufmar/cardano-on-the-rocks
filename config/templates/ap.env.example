# AP / bridge settings. prepare/ap-prepare may seed /etc/cot-r/ap.env (no PSK here).
# Copyright (C) 2026 Markus. SPDX-License-Identifier: AGPL-3.0-only

# Generated SSID is "Cardano-on-the-Rocks .<last-octet>" from the DHCP lease
# (example: 172.27.213.196 -> "Cardano-on-the-Rocks .196").
# Set COT_R_AP_SSID_OVERRIDE only if you need a manual SSID.
COT_R_AP_SSID='Cardano-on-the-Rocks .196'
# COT_R_AP_SSID_OVERRIDE=

# PSK file path (contents never committed). Generated by ap-prepare if missing.
COT_R_AP_PSK_FILE=/etc/cot-r/ap.psk

# 2.4 GHz channel (1, 6, or 11 preferred). Fixed channel for brcmfmac AP reliability.
COT_R_AP_CHANNEL=6

# ISO country code for regulatory (Init7 upstream context: CH).
COT_R_WIFI_COUNTRY=CH

# Bridge and member interfaces
COT_R_BRIDGE=br0
COT_R_ETH_IF=end0
COT_R_WLAN_IF=wlan0

# hostapd config path
COT_R_HOSTAPD_CONF=/etc/cot-r/hostapd.conf
