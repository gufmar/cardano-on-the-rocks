# AP settings template. Real values are written by: sudo ./scripts/cot-r ap-prepare
# Copyright (C) 2026 Markus. SPDX-License-Identifier: AGPL-3.0-only
#
# Default SSID is short for OLED Wi-Fi QR (128x64 needs <=~32 modules at 2px):
#   RockPi 1 / .195 -> "Cardano-Rocks 1"
#   RockPi 2 / .196 -> "Cardano-Rocks 2"
#   RockPi 3 / .194 -> "Cardano-Rocks 3"
# Override only if needed:
# COT_R_AP_SSID_OVERRIDE=MyCustomSSID
COT_R_AP_SSID='Cardano-Rocks 2'
# PSK lives in /etc/cot-r/ap.psk (10 chars by default; never commit).
