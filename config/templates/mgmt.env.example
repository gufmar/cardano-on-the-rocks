# Management service environment. Copied to /etc/cot-r/mgmt.env by prepare if missing.
# Copyright (C) 2026 Markus. SPDX-License-Identifier: AGPL-3.0-only

COT_R_MGMT_BIND=0.0.0.0
COT_R_MGMT_PORT=8080
# Tokens live under /etc/cot-r/ (created by prepare; never commit):
#   api.token  – operator Bearer for status / claim / reset
#   peer.token – shared cluster Bearer for peer claim/heartbeat (same on all boards)
# Optional tuning:
# COT_R_COORD_LEASE_SECONDS=45
# COT_R_COORD_HEARTBEAT_INTERVAL=15
# COT_R_PEER_HTTP_TIMEOUT=2.0
#
# mAP SSH (uplink scan/connect). Default user is rockpi1/2/3 from device id.
# COT_R_MAP_HOST=172.27.213.1
# COT_R_MAP_USER=rockpi2
# COT_R_MAP_WLAN=wlan1
# COT_R_MAP_SEC_PROFILE=uplink
