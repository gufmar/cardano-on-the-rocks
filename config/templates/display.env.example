# Display service environment. prepare writes /etc/cot-r/display.env after discovery.
# Copyright (C) 2026 Markus. SPDX-License-Identifier: AGPL-3.0-only

COT_R_I2C_BUS=7
COT_R_I2C_ADDRESS=0x3c
COT_R_DISPLAY_WIDTH=128
COT_R_DISPLAY_HEIGHT=64
COT_R_DISPLAY_SOCKET=/run/cot-r/display.sock
COT_R_DISPLAY_MAX_FPS=10
COT_R_DISPLAY_ORIENTATION=0
