# Device identity template. Copied to /etc/cot-r/ as an example only.
# prepare writes /etc/cot-r/device.env after this board's IP is chosen.
# Do not commit real device.env files or secrets.
# Copyright (C) 2026 Markus. SPDX-License-Identifier: AGPL-3.0-only

# Stable logical name for this board (not derived solely from IP).
# RockPi 1 / 2 / 3 -> rockpi-1 / rockpi-2 / rockpi-3
# COT_R_DEVICE_ID=

# Fixed management IPv4 for THIS RockPi only (required before static addressing).
# RockPi 1: 172.27.213.195
# RockPi 2: 172.27.213.196
# RockPi 3: 172.27.213.194
# Leave unset until prepare resolves identity (MAC map, --reserved-ipv4, or prompt).
# COT_R_RESERVED_IPV4=

COT_R_GATEWAY=172.27.213.1
COT_R_DNS=172.27.213.1
COT_R_PREFIX=24

# SSID is derived as "Cardano-on-the-Rocks .<last-octet>" from COT_R_RESERVED_IPV4
# unless overridden:
# COT_R_AP_SSID_OVERRIDE=MyCustomSSID

# AP PSK is stored in a separate file, not here.
# COT_R_AP_PSK_FILE=/etc/cot-r/ap.psk

# Peer discovery list (comma-separated). Defaults to .194,.195,.196 if unset.
# COT_R_PEER_ADDRS=172.27.213.194,172.27.213.195,172.27.213.196
