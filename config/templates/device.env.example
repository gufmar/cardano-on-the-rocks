# Device identity template. Copy to /etc/cot-r/device.env on each RockPi.
# Do not commit real device.env files or secrets.
# Copyright (C) 2026 Markus. SPDX-License-Identifier: AGPL-3.0-only

# Stable logical name for this board (not derived solely from IP).
COT_R_DEVICE_ID=rockpi-unset

# Reserved Ethernet address (informational; DHCP still assigns it).
# RockPi 1: 172.27.213.195
# RockPi 2: 172.27.213.196
# RockPi 3: 172.27.213.194
COT_R_RESERVED_IPV4=172.27.213.0

# Compact AP SSID (set during later AP provisioning). Leave empty until then.
COT_R_AP_SSID=

# AP PSK is stored in a separate root-readable secret file, not here.
# COT_R_AP_PSK_FILE=/etc/cot-r/ap.psk
